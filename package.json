{
  "name": "@cinatra-ai/resend-connector",
  "version": "0.1.2",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "src",
    "!src/__tests__"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./register": "./src/register.ts"
  },
  "scripts": {
    "test": "vitest"
  },
  "dependencies": {
    "resend": "^4.0.1"
  },
  "peerDependencies": {
    "@cinatra-ai/sdk-extensions": "*"
  },
  "peerDependenciesMeta": {
    "@cinatra-ai/sdk-extensions": {
      "optional": true
    }
  },
  "cinatra": {
    "apiVersion": "cinatra.ai/v1",
    "kind": "connector",
    "vendor": {
      "key": "cinatra-ai",
      "name": "Cinatra"
    },
    "displayName": "Resend",
    "dependencies": [
      {
        "packageName": "@cinatra-ai/email-connector",
        "kind": "connector",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "^0.1.1"
        },
        "requirement": "required"
      }
    ],
    "serverEntry": "./register",
    "requestedHostPorts": [
      "capabilities"
    ],
    "sdkAbiRange": "^2",
    "consumes": []
  }
}
