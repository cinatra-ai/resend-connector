{
  "name": "@cinatra-ai/resend-connector",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./register": "./src/register.ts"
  },
  "scripts": {
    "test": "vitest"
  },
  "dependencies": {
    "resend": "^4.0.1"
  },
  "peerDependencies": {
    "@cinatra-ai/sdk-extensions": "*"
  },
  "cinatra": {
    "apiVersion": "cinatra.ai/v1",
    "kind": "connector",
    "dependencies": [
      {
        "packageName": "@cinatra-ai/email-connector",
        "kind": "connector",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "*"
        },
        "requirement": "required"
      }
    ],
    "serverEntry": "./register",
    "requestedHostPorts": [
      "capabilities"
    ],
    "sdkAbiRange": "^2"
  }
}
